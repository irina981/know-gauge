# Optional. docker-compose.yml has defaults for everything below (matching application-local.properties).
# Copy to .env only to override a value or to set OPENAI_API_KEY.

# ===============================
# PostgreSQL: one database, schemas knowgauge, vectors and keycloak (ADR011)
# ===============================

POSTGRES_DB=knowgauge
POSTGRES_USER=knowgauge_user
POSTGRES_PASSWORD=knowgauge_pass
# Keycloak's own login, limited to the keycloak schema (created with the data volume)
KEYCLOAK_DB_USER=keycloak_user
KEYCLOAK_DB_PASSWORD=keycloak_pass

# ===============================
# MinIO
# ===============================

MINIO_BUCKET=knowgauge-content
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345

# ===============================
# Open AI
# ===============================

OPENAI_API_KEY=your-opn-api-key


