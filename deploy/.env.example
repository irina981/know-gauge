# Copy to deploy/.env and fill in. deploy/.env holds secrets: it is gitignored, never commit it.
# Variables marked "required" have no default; docker compose stops with an error when one is missing.

# ===============================
# Secrets (required)
# ===============================

# Use long random values, e.g. `openssl rand -base64 24`.
POSTGRES_PASSWORD=
# Keycloak's own database login (schema keycloak only)
KEYCLOAK_DB_PASSWORD=
# Keycloak's admin console (master realm), user KC_BOOTSTRAP_ADMIN_USERNAME (default admin)
KC_BOOTSTRAP_ADMIN_PASSWORD=
# At least 8 characters.
MINIO_ROOT_PASSWORD=
OPENAI_API_KEY=

# Public address of the UI, as participants open it (used in invitation links), e.g. https://tests.example.com
KG_PUBLIC_UI_URL=

# Public address of Keycloak (sign-in), behind a reverse proxy with HTTPS, e.g. https://auth.example.com
KG_AUTH_URL=

# The first KnowGauge admin: a Keycloak user created when the realm is imported, who gets the ADMIN role from the app
# at sign-in (ADR012). The password is temporary:
# Keycloak asks for a new one at the first sign-in.
KG_ADMIN_EMAIL=
KG_ADMIN_PASSWORD=

# ===============================
# Optional (defaults shown)
# ===============================

# POSTGRES_DB=knowgauge
# POSTGRES_USER=knowgauge_user
# KEYCLOAK_DB_USER=keycloak_user
# KC_BOOTSTRAP_ADMIN_USERNAME=admin
# MINIO_ROOT_USER=knowgauge
# KG_STORAGE_BUCKET=knowgauge-content

# Only used in security mode fixed (no sign-in); this deployment signs in through Keycloak.
# KG_TENANT_ID=1
# KG_USER_ID=

# Port the UI is published on. Put a reverse proxy with HTTPS in front of it for real use.
# KG_HTTP_PORT=80

# Port Keycloak listens on (127.0.0.1 only), for the reverse proxy.
# KG_KEYCLOAK_PORT=8180

# Path of the know-gauge-ui clone, relative to this folder. Keycloak loads the login theme from its dist_keycloak
# folder (`npm run build-keycloak-theme` there).
# KG_UI_SOURCE=../../know-gauge-ui

# Logging: ecs (JSON, default), logstash or gelf; level for com.knowgauge.
# KG_LOG_FORMAT=ecs
# KG_LOG_LEVEL=INFO
# KG_ENVIRONMENT=prod

# AI tokens (input + output) each workspace may use per calendar month. An ADMIN can override it on the System
# settings page; that value wins until reset there.
# KG_TENANT_MONTHLY_TOKEN_LIMIT=1000000
# Megabytes of PDFs each workspace may keep (the shared library has no limit).
# KG_TENANT_STORAGE_LIMIT_MB=500
# Tests one user may generate at the same time.
# KG_CONCURRENT_GENERATIONS_PER_USER=1

# Invitation emails, and Keycloak's verification and password-reset emails, go through your SMTP server. Without
# KG_MAIL_HOST invitations are created, but sending fails and the error is shown on each invitation.
# KG_MAIL_HOST=
# KG_MAIL_PORT=587
# KG_MAIL_USERNAME=
# KG_MAIL_PASSWORD=
# KG_MAIL_SMTP_AUTH=true
# KG_MAIL_STARTTLS=true
# KG_MAIL_FROM=KnowGauge <no-reply@knowgauge.local>
# The bare address Keycloak sends from
# KG_MAIL_FROM_ADDRESS=no-reply@knowgauge.local

# Dozzle listens on 127.0.0.1 at this port.
# DOZZLE_PORT=8888
