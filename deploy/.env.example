# Copy to deploy/.env and fill in. deploy/.env holds secrets: it is gitignored, never commit it.
# Variables marked "required" have no default; docker compose stops with an error when one is missing.

# ===============================
# Secrets (required)
# ===============================

# Use long random values, e.g. `openssl rand -base64 24`.
POSTGRES_PASSWORD=
POSTGRES_VECTORS_PASSWORD=
# At least 8 characters.
MINIO_ROOT_PASSWORD=
OPENAI_API_KEY=

# ===============================
# Optional (defaults shown)
# ===============================

# POSTGRES_DB=knowgauge
# POSTGRES_USER=knowgauge_user
# POSTGRES_VECTORS_DB=knowgauge_vectors
# POSTGRES_VECTORS_USER=knowgauge_user
# MINIO_ROOT_USER=knowgauge
# KG_STORAGE_BUCKET=knowgauge-content

# One tenant per deployment until there is authentication.
# KG_TENANT_ID=1
# KG_USER_ID=

# Port the UI is published on. Put a reverse proxy with HTTPS in front of it for real use.
# KG_HTTP_PORT=80

# Path of the know-gauge-ui clone, relative to this folder.
# KG_UI_SOURCE=../../know-gauge-ui

# Logging: ecs (JSON, default), logstash or gelf; level for com.knowgauge.
# KG_LOG_FORMAT=ecs
# KG_LOG_LEVEL=INFO
# KG_ENVIRONMENT=prod

# Dozzle listens on 127.0.0.1 at this port.
# DOZZLE_PORT=8888
